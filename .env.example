# Telegram (trade-notificaties, commando-bot)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Kraken spot USD — alleen via omgeving (.env); nooit in code of commits
KRAKEN_API_KEY=
# Primaire naam voor de private key (gebruik deze in GitHub Actions secrets)
KRAKEN_API_SECRET=
# Legacy alias (lokaal nog ondersteund; migreren naar KRAKEN_API_SECRET)
# KRAKEN_SECRET_KEY=

# Standaard true (veilig): log bedoelde orders, geen live limits. Zet op false voor echte orders.
KRAKEN_DRY_RUN=true
# Optioneel: maximale geschatte positiewaarde in USD na een koop (per symbool); leeg = geen extra limiet
# KRAKEN_MAX_POSITION_VALUE_USD=
# true = post-only / geen taker: order wordt geweigerd als hij het boek kruist (aanbevolen)
KRAKEN_POST_ONLY=true
# Optioneel: overschrijf voor Kraken-runner + command-bot
# TELEGRAM_BOT_TOKEN_KRAKEN=
# TELEGRAM_CHAT_ID_KRAKEN=
# KRAKEN_BOT_TRADE_LOG=     # uit: false/off; default kraken_bot_trades.jsonl

# Logging (optioneel)
# RANGEBOT_LOG_FORMAT=text   # of json voor log aggregators
# RANGEBOT_LOG_LEVEL=INFO
